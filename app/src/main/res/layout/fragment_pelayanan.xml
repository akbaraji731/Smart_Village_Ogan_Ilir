<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.PelayananFragment">

    <LinearLayout
        android:id="@+id/menumenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.19999999">

        <TextView
            android:id="@+id/keterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

        <EditText
            android:id="@+id/inNama"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:hint="Masukkan Nama"
            android:inputType="textPersonName"
            android:text="" />

        <EditText
            android:id="@+id/inNIK"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:hint="Masukkan NIK"
            android:inputType="textPersonName"
            android:text="" />

        <EditText
            android:id="@+id/inAlamat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:hint="Masukkan Alamat"
            android:inputType="textPersonName"
            android:text="" />

        <EditText
            android:id="@+id/inJenisSurat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:hint="Masukkan Jenis Surat"
            android:inputType="textPersonName"
            android:text="" />

        <EditText
            android:id="@+id/inIsiSurat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ems="10"
            android:hint="Masukkan Isi Surat"
            android:inputType="textPersonName"
            android:text="" />

        <Button
            android:id="@+id/kirimSurat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Kirim" />



    </LinearLayout>

</RelativeLayout>